{
  "name": "academia-gestao",
  "version": "1.0.0",
  "description": "Sistema desktop de gestão para academia de bairro (Electron + TypeScript + MySQL)",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/app.ts src/renderer/index.html src/renderer/styles.css --bundle --outdir=dist/renderer --format=iife --target=chrome130 --loader:.html=copy --loader:.woff2=file --loader:.woff=file --asset-names=assets/[name]-[hash]",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@types/node": "^22.20.5",
    "electron": "^45.2.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "mysql2": "^3.24.6"
  }
}
